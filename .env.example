# Variables para docker compose (cópialo a .env y rellena lo tuyo).
# El archivo .env está en .gitignore: NO se sube a git.

# --- Resend (envío de correos del enlace mágico) ---
# Crea una API key en https://resend.com. Sin esto, el enlace se imprime en los logs.
RESEND_API_KEY=
# Remitente. Usa un dominio verificado en Resend, o el de prueba onboarding@resend.dev
# (este último solo envía a la dirección de tu propia cuenta Resend).
MAIL_FROM=Mis Láminas <onboarding@resend.dev>

# --- Opcionales ---
# Base pública de la app para construir los enlaces (vacío = se deduce del request).
# En producción detrás de un dominio: https://tu-dominio.com
APP_URL=
# Secreto para firmar las sesiones (cámbialo por algo largo y único).
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-secreta
