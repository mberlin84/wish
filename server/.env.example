# Conexión a PostgreSQL
DATABASE_URL=postgres://usuario:clave@localhost:5432/mislaminas
# Pon true si tu Postgres requiere SSL (ej. proveedores en la nube)
DATABASE_SSL=false

# Secreto para firmar los tokens de sesión (JWT). Cámbialo por algo largo y único.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# Puerto del servidor
PORT=3000

# Nombre del álbum que se muestra en la app
ALBUM_NAME=Mundial 2026

# --- Login por enlace mágico (Resend) ---
# API key de https://resend.com. Sin esto, el enlace se imprime en los logs (modo dev).
RESEND_API_KEY=
# Remitente (dominio verificado en Resend, o el de prueba onboarding@resend.dev).
MAIL_FROM=Mis Láminas <onboarding@resend.dev>
# Base pública para construir los enlaces (vacío = se deduce del request).
APP_URL=
